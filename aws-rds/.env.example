# AWS RDS MySQL Connection Configuration
# Copy this file to .env and fill in your actual values

# RDS Endpoint (found in AWS Console -> RDS -> Your Instance -> Connectivity & security)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com

# Database Port (default is 3306 for MySQL)
DB_PORT=3306

# Database Username (set when creating RDS instance)
DB_USER=admin

# Database Password (set when creating RDS instance)
DB_PASSWORD=your-password-here

# Database Name (create this in your RDS instance or use existing one)
DB_NAME=testdb
